{
  "name": "threads-archiver",
  "private": true,
  "version": "0.8.1",
  "description": "Threads 공유 링크 하나로 사진·영상·글(연속 게시물 포함)을 내 컴퓨터에 아카이빙하는 데스크톱 앱",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @threads-archiver/core && npm run build -w @threads-archiver/desktop",
    "dev": "npm run dev -w @threads-archiver/desktop",
    "test": "npm run test -w @threads-archiver/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "setup:browser": "node scripts/install-browser.mjs",
    "bundle": "npm run tauri -w @threads-archiver/desktop -- build --config src-tauri/tauri.bundle.json"
  },
  "engines": {
    "node": ">=20.11"
  }
}
