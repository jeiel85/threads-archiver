{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Threads Archiver",
  "version": "0.10.1",
  "identifier": "com.jeiel.threadsarchiver",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Threads Archiver",
        "visible": false,
        "width": 940,
        "height": 760,
        "minWidth": 720,
        "minHeight": 600,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:*"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyMDI0RDRFNzMyODk3RDUKUldUVmx5aHpUazBDWW54YTRkbC9DcWlJWkowMHhHakdGT1dxd3RDWFF2c0hxeU5UTmJGUWFDRCsK",
      "endpoints": ["https://github.com/jeiel85/threads-archiver/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
