{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build && node ../../scripts/stage-bundle.mjs"
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "bundle-resources/engine/": "engine/",
      "bundle-resources/node/": "node/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"]
      }
    }
  }
}
